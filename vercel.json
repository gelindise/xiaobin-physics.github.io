{
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/vip", "destination": "/vip.html" },
    { "source": "/pay", "destination": "/pay.html" },
    { "source": "/experiments", "destination": "/experiments.html" },
    { "source": "/(.*)", "destination": "/$1" }
  ],
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },

    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "public, max-age=120, s-maxage=120" }] },
    { "source": "/admin", "headers": [{ "key": "Cache-Control", "value": "public, max-age=120, s-maxage=120" }] },
    { "source": "/login", "headers": [{ "key": "Cache-Control", "value": "public, max-age=120, s-maxage=120" }] },
    { "source": "/register", "headers": [{ "key": "Cache-Control", "value": "public, max-age=120, s-maxage=120" }] },
    { "source": "/vip", "headers": [{ "key": "Cache-Control", "value": "public, max-age=120, s-maxage=120" }] },
    { "source": "/pay", "headers": [{ "key": "Cache-Control", "value": "public, max-age=120, s-maxage=120" }] },
    { "source": "/experiments", "headers": [{ "key": "Cache-Control", "value": "public, max-age=120, s-maxage=120" }] },

    { "source": "/(.*)\\.html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=120, s-maxage=120" }] },

    { "source": "/:file.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=120, s-maxage=120" }] },
    { "source": "/:file.css", "headers": [{ "key": "Cache-Control", "value": "public, max-age=120, s-maxage=120" }] },

    { "source": "/:file.js", "has": [{ "type": "query", "key": "build" }], "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, s-maxage=2592000, immutable" }] },
    { "source": "/:file.css", "has": [{ "type": "query", "key": "build" }], "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, s-maxage=2592000, immutable" }] },

    { "source": "/assets/:file.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=604800" }] },
    { "source": "/assets/:file.css", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=604800" }] },

    { "source": "/(.*)\\.png", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=604800" }] },
    { "source": "/(.*)\\.jpg", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=604800" }] },
    { "source": "/(.*)\\.jpeg", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=604800" }] },
    { "source": "/(.*)\\.webp", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=604800" }] },
    { "source": "/(.*)\\.gif", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=604800" }] },
    { "source": "/(.*)\\.svg", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=604800" }] },
    { "source": "/(.*)\\.ico", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=604800" }] },
    { "source": "/(.*)\\.mp3", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=604800" }] },
    { "source": "/(.*)\\.mp4", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=604800" }] },
    { "source": "/(.*)\\.obj", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=604800" }] },
    { "source": "/(.*)\\.woff2", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=604800" }] },
    { "source": "/(.*)\\.woff", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=604800" }] },

    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] }
  ]
}
