# 环境变量清单（模板，可以安全提交；真实值绝不写在这里）
#
# 本机调试：复制为 .env.local 再填值（.env.local 已被 .gitignore 忽略）
# 线上配置：Vercel → 项目 → Settings → Environment Variables
#           只勾 Production / Preview，不要把 service_role 放进任何前端变量
#
# 变量名与 api/*.js 中 process.env.XXX 一一对应，值一律留空。

SUPABASE_URL=
# service_role 密钥：仅服务端函数使用，权限最大，泄露等于数据库裸奔
SUPABASE_SERVICE_KEY=
# 管理员后台口令：建议 16 位以上随机串，不要用生日 / 姓名缩写 / 手机号
ADMIN_PASSWORD=
# 面包多支付
MBD_DEVELOPER_KEY=
MBD_QUERY_URL=
# 视频解析（如有使用）
VIDEO_PARSE_API=
VIDEO_PARSE_FIELD=
VIDEO_PARSE_KEY=
